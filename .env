# Cole em: backend/.env
# Renomeie este arquivo de .env.example para .env

# PostgreSQL — troque pelo seu usuário/senha/nome do banco
DATABASE_URL="postgresql://postgres:0507@localhost:5432/sightagro"

# JWT — troque por uma string aleatória longa em produção
JWT_SECRET="agrosmart-super-secret-key-mude-em-producao-12345"

# Porta do servidor (padrão: 3333)
PORT=3333

# URL do frontend (para CORS)
FRONTEND_URL="http://localhost:5173"
