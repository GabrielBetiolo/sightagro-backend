// ============================================================================
// SCHEMA DO BANCO DE DADOS - AGROSMART
// ============================================================================
// Este arquivo define todos os modelos (tabelas) do banco PostgreSQL.
// Após editar, rode: npx prisma migrate dev --name <nome_da_migration>
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// USUÁRIO
// ----------------------------------------------------------------------------
model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  role     String  @default("user")
  avatar   String?
  phone    String?
  timezone String? @default("America/Sao_Paulo")
  language String? @default("pt-BR")

  plan             String    @default("free")
  planExpiresAt    DateTime?
  mpSubscriptionId String?

  resetToken        String?
  resetTokenExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fazendas          Fazenda[]
  pushSubscriptions PushSubscription[]
}

// ----------------------------------------------------------------------------
// FAZENDA
// ----------------------------------------------------------------------------
model Fazenda {
  id          Int    @id @default(autoincrement())
  nome        String
  localizacao String
  area        Float
  cultura     String
  status      String @default("ativa")

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sensores       Sensor[]
  alertas        Alerta[]
  irrigacoes     Irrigacao[]
  documentos     Documento[]
  transacoes     Transacao[]
  financiamentos Financiamento[]
  colaboradores  Colaborador[] // NOVO: equipe vinculada à fazenda
  tarefas        Tarefa[] // NOVO: tarefas vinculadas à fazenda
}

// ----------------------------------------------------------------------------
// SENSOR
// ----------------------------------------------------------------------------
model Sensor {
  id            Int       @id @default(autoincrement())
  codigo        String    @unique
  tipo          String
  status        String    @default("online")
  bateria       Int       @default(100)
  token         String?   @unique
  ultimaLeitura DateTime?

  fazendaId Int
  fazenda   Fazenda @relation(fields: [fazendaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leituras Leitura[]
}

// ----------------------------------------------------------------------------
// LEITURA
// ----------------------------------------------------------------------------
model Leitura {
  id        Int      @id @default(autoincrement())
  sensorId  Int
  sensor    Sensor   @relation(fields: [sensorId], references: [id])
  valor     Float
  unidade   String
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// ALERTA
// ----------------------------------------------------------------------------
model Alerta {
  id        Int     @id @default(autoincrement())
  tipo      String
  titulo    String
  descricao String
  lido      Boolean @default(false)

  fazendaId Int
  fazenda   Fazenda @relation(fields: [fazendaId], references: [id])

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// IRRIGACAO
// ----------------------------------------------------------------------------
model Irrigacao {
  id      Int       @id @default(autoincrement())
  zona    String
  ativa   Boolean   @default(false)
  fluxo   Float     @default(0)
  duracao Int       @default(30)
  proxima DateTime?

  fazendaId Int
  fazenda   Fazenda @relation(fields: [fazendaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// PUSH SUBSCRIPTION
// ----------------------------------------------------------------------------
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  keys      String
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// DOCUMENTO
// ----------------------------------------------------------------------------
model Documento {
  id             Int       @id @default(autoincrement())
  nome           String
  tipo           String
  arquivoUrl     String
  arquivoTipo    String
  numero         String?
  dataEmissao    DateTime?
  dataVencimento DateTime?

  fazendaId Int
  fazenda   Fazenda @relation(fields: [fazendaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// TRANSACAO (financeiro)
// ----------------------------------------------------------------------------
model Transacao {
  id        Int      @id @default(autoincrement())
  tipo      String
  categoria String
  descricao String
  valor     Float
  data      DateTime

  fazendaId Int
  fazenda   Fazenda @relation(fields: [fazendaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// FINANCIAMENTO (CPR / financiamentos)
// ----------------------------------------------------------------------------
model Financiamento {
  id              Int       @id @default(autoincrement())
  tipo            String
  instituicao     String
  descricao       String?
  valor           Float
  taxaJuros       Float?
  dataContratacao DateTime?
  dataVencimento  DateTime?
  status          String    @default("ativo")

  fazendaId Int
  fazenda   Fazenda @relation(fields: [fazendaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// NOVO: GESTÃO DE COLABORADORES
// ============================================================================

// ----------------------------------------------------------------------------
// COLABORADOR - Funcionário/trabalhador vinculado a uma fazenda
// ----------------------------------------------------------------------------
model Colaborador {
  id           Int       @id @default(autoincrement())
  nome         String
  funcao       String // cargo/função, ex: "Tratorista", "Encarregado"
  telefone     String?
  email        String?
  dataAdmissao DateTime?
  salario      Float? // valor mensal (opcional, sensível)
  status       String    @default("ativo") // "ativo" | "inativo"

  fazendaId Int
  fazenda   Fazenda @relation(fields: [fazendaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tarefas        Tarefa[]
  registrosPonto RegistroPonto[]
}

// ----------------------------------------------------------------------------
// TAREFA - Atribuição de trabalho a um colaborador (estilo kanban)
// ----------------------------------------------------------------------------
model Tarefa {
  id         Int       @id @default(autoincrement())
  titulo     String
  descricao  String?
  status     String    @default("pendente") // pendente | em_andamento | concluida
  prioridade String    @default("media") // baixa | media | alta
  dataPrazo  DateTime?

  colaboradorId Int?
  colaborador   Colaborador? @relation(fields: [colaboradorId], references: [id])

  fazendaId Int
  fazenda   Fazenda @relation(fields: [fazendaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// REGISTRO DE PONTO - Controle simplificado de presença/horas trabalhadas
// ----------------------------------------------------------------------------
// Um registro por dia/colaborador. "entrada" e "saida" são timestamps;
// quando ambos estão preenchidos, o dia é considerado completo.
// ----------------------------------------------------------------------------
model RegistroPonto {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])

  data       DateTime // referência do dia (apenas a data importa)
  entrada    DateTime?
  saida      DateTime?
  observacao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
