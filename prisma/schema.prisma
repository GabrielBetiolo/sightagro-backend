// schema.prisma — SightAgro (versão completa acumulada)
// Migration: npx prisma migrate dev --name add_mapa_talhoes_maquinarios

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Usuário ──────────────────────────────────────────────────────────────────
model User {
  id            Int       @id @default(autoincrement())
  nome          String
  email         String    @unique
  senha         String
  avatarUrl     String?
  telefone      String?
  idioma        String?   @default("pt")
  fusoHorario   String?   @default("America/Sao_Paulo")
  tema          String?   @default("dark")
  plano         String    @default("free")
  assinaturaId  String?
  resetToken    String?
  resetTokenExp DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  fazendas      Fazenda[]
  colaboradores Colaborador[]
  insumosEstoque InsumoEstoque[]
  maquinarios   Maquinario[]    // ← NOVO
}

// ─── Fazenda ──────────────────────────────────────────────────────────────────
model Fazenda {
  id           Int      @id @default(autoincrement())
  userId       Int
  nome         String
  localizacao  String?
  latitude     Float?
  longitude    Float?
  areaHa       Float?
  mapaPoligono String?  // GeoJSON da área total ← NOVO
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User       @relation(fields: [userId], references: [id])
  sensores     Sensor[]
  alertas      Alerta[]
  irrigacoes   Irrigacao[]
  documentos   Documento[]
  transacoes   TransacaoFinanceira[]
  movimentacoes MovimentacaoEstoque[]
  lotes        Lote[]
  tanques      Tanque[]
  pragas       Praga[]
  talhoes      Talhao[]   // ← NOVO
}

// ─── Sensor ───────────────────────────────────────────────────────────────────
model Sensor {
  id        Int      @id @default(autoincrement())
  fazendaId Int
  nome      String
  codigo    String   @unique
  tipo      String
  ativo     Boolean  @default(true)
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())

  fazenda   Fazenda   @relation(fields: [fazendaId], references: [id])
  leituras  Leitura[]
}

model Leitura {
  id        Int      @id @default(autoincrement())
  sensorId  Int
  valor     Float
  unidade   String
  timestamp DateTime @default(now())

  sensor    Sensor @relation(fields: [sensorId], references: [id])
}

// ─── Alerta ───────────────────────────────────────────────────────────────────
model Alerta {
  id        Int      @id @default(autoincrement())
  fazendaId Int
  tipo      String
  titulo    String
  mensagem  String
  nivel     String
  lido      Boolean  @default(false)
  createdAt DateTime @default(now())

  fazenda   Fazenda @relation(fields: [fazendaId], references: [id])
}

// ─── Irrigação ────────────────────────────────────────────────────────────────
model Irrigacao {
  id          Int      @id @default(autoincrement())
  fazendaId   Int
  nome        String
  tipo        String
  status      String   @default("inativo")
  agendamento String?
  duracaoMin  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fazenda     Fazenda @relation(fields: [fazendaId], references: [id])
}

// ─── Push Notifications ───────────────────────────────────────────────────────
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ─── Documento Rural ─────────────────────────────────────────────────────────
model Documento {
  id             Int       @id @default(autoincrement())
  fazendaId      Int
  nome           String
  tipo           String
  numero         String?
  dataEmissao    DateTime?
  dataVencimento DateTime?
  urlArquivo     String?
  observacoes    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  fazenda        Fazenda   @relation(fields: [fazendaId], references: [id])
}

// ─── Financeiro ───────────────────────────────────────────────────────────────
model TransacaoFinanceira {
  id          Int      @id @default(autoincrement())
  fazendaId   Int
  tipo        String
  categoria   String
  descricao   String
  valor       Float
  data        DateTime
  comprovante String?
  createdAt   DateTime @default(now())

  fazenda     Fazenda  @relation(fields: [fazendaId], references: [id])
}

// ─── Colaboradores ────────────────────────────────────────────────────────────
model Colaborador {
  id        Int      @id @default(autoincrement())
  userId    Int
  nome      String
  funcao    String
  telefone  String?
  email     String?
  salario   Float?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  tarefas   Tarefa[]
  registrosPonto RegistroPonto[]
}

model Tarefa {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  titulo        String
  descricao     String?
  status        String      @default("pendente")
  prioridade    String      @default("normal")
  dataLimite    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
}

model RegistroPonto {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  data          DateTime    @default(now())
  entrada       DateTime
  saida         DateTime?
  observacao    String?

  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
}

// ─── Estoque de Insumos ───────────────────────────────────────────────────────
model InsumoEstoque {
  id               Int      @id @default(autoincrement())
  userId           Int
  nome             String
  categoria        String
  unidade          String
  quantidadeAtual  Float    @default(0)
  quantidadeMinima Float    @default(0)
  custo            Float?
  fornecedor       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user          User   @relation(fields: [userId], references: [id])
  movimentacoes MovimentacaoEstoque[]
}

model MovimentacaoEstoque {
  id         Int      @id @default(autoincrement())
  insumoId   Int
  fazendaId  Int?
  tipo       String
  quantidade Float
  motivo     String?
  data       DateTime @default(now())

  insumo     InsumoEstoque @relation(fields: [insumoId], references: [id])
  fazenda    Fazenda?      @relation(fields: [fazendaId], references: [id])
}

// ─── Pecuária ────────────────────────────────────────────────────────────────
model Lote {
  id         Int      @id @default(autoincrement())
  fazendaId  Int
  nome       String
  especie    String
  categoria  String
  quantidade Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fazenda    Fazenda    @relation(fields: [fazendaId], references: [id])
  animais    Animal[]
  vacinacoes Vacinacao[]
  gtas       GTA[]
}

model Animal {
  id           Int       @id @default(autoincrement())
  loteId       Int
  numeroBrinco String?   @unique
  nome         String?
  dataNasc     DateTime?
  sexo         String?
  raca         String?
  createdAt    DateTime  @default(now())

  lote         Lote      @relation(fields: [loteId], references: [id])
  pesagens     Pesagem[]
}

model Pesagem {
  id         Int      @id @default(autoincrement())
  animalId   Int
  pesoKg     Float
  data       DateTime @default(now())
  observacao String?

  animal     Animal   @relation(fields: [animalId], references: [id])
}

model Vacinacao {
  id            Int      @id @default(autoincrement())
  loteId        Int
  vacina        String
  dataAplicacao DateTime
  proximaDose   DateTime?
  doseMl        Float?
  veterinario   String?

  lote          Lote     @relation(fields: [loteId], references: [id])
}

model GTA {
  id             Int      @id @default(autoincrement())
  loteId         Int
  numero         String
  dataEmissao    DateTime
  dataVencimento DateTime
  destino        String?
  urlArquivo     String?

  lote           Lote     @relation(fields: [loteId], references: [id])
}

// ─── Aquicultura ─────────────────────────────────────────────────────────────
model Tanque {
  id               Int      @id @default(autoincrement())
  fazendaId        Int
  nome             String
  tipo             String
  volumeM3         Float?
  especie          String
  quantidadePeixes Int?
  dataPovoamento   DateTime?
  cicloAtivo       Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fazenda          Fazenda  @relation(fields: [fazendaId], references: [id])
  medicoes         MedicaoAgua[]
  alimentacoes     Alimentacao[]
  colheitas        ColheitaAquicultura[]
}

model MedicaoAgua {
  id          Int      @id @default(autoincrement())
  tanqueId    Int
  temperatura Float?
  ph          Float?
  oxigenio    Float?
  amonia      Float?
  turbidez    Float?
  data        DateTime @default(now())
  observacao  String?

  tanque      Tanque   @relation(fields: [tanqueId], references: [id])
}

model Alimentacao {
  id           Int      @id @default(autoincrement())
  tanqueId     Int
  tipoRacao    String
  quantidadeKg Float
  data         DateTime @default(now())

  tanque       Tanque   @relation(fields: [tanqueId], references: [id])
}

model ColheitaAquicultura {
  id           Int      @id @default(autoincrement())
  tanqueId     Int
  quantidadeKg Float
  pesoMedioG   Float?
  data         DateTime @default(now())
  observacao   String?

  tanque       Tanque   @relation(fields: [tanqueId], references: [id])
}

// ─── Manejo de Pragas ─────────────────────────────────────────────────────────
model Praga {
  id                Int      @id @default(autoincrement())
  fazendaId         Int
  cultura           String
  tipoProblema      String
  descricao         String
  areaAfetadaHa     Float?
  fotoUrl           String?
  urgencia          String   @default("media")
  status            String   @default("aberta")
  notasAdicionais   String?
  defensivoAplicado String?
  dataAplicacao     DateTime?
  diagnosticoIA     String?
  defensivosIA      String?
  manejoIA          String?
  prevencaoIA       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  fazenda           Fazenda  @relation(fields: [fazendaId], references: [id])
}

// ─── Mapa da Propriedade ─────────────────────────────────────────────────────  ← NOVOS

// Talhão: subdivisão de uma fazenda com cultura plantada
model Talhao {
  id        Int      @id @default(autoincrement())
  fazendaId Int
  nome      String                           // "Talhão Norte", "Área 2 - Soja"
  cultura   String?                          // Soja, Milho, Pastagem, etc.
  areaHa    Float?
  cor       String?  @default("#22c55e")     // cor HEX para exibir no mapa
  geojson   String?                          // polígono GeoJSON do talhão
  status    String   @default("vazio")       // plantado | colhido | em_preparo | vazio
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fazenda   Fazenda  @relation(fields: [fazendaId], references: [id])
}

// Maquinário com rastreamento GPS em tempo real
model Maquinario {
  id               Int      @id @default(autoincrement())
  userId           Int
  nome             String                       // "Trator JD 5075E"
  tipo             String                       // trator | colheitadeira | pulverizador | caminhao | outro
  placa            String?
  modelo           String?
  ano              Int?
  token            String   @unique             // token para dispositivo GPS embarcado
  ativo            Boolean  @default(true)
  ultimaLatitude   Float?                       // cache da última posição
  ultimaLongitude  Float?
  ultimaVez        DateTime?                    // timestamp da última atualização GPS
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id])
  posicoes         PosicaoMaquinario[]
}

// Histórico de posições GPS (trilha de rastreamento)
model PosicaoMaquinario {
  id           Int      @id @default(autoincrement())
  maquinarioId Int
  latitude     Float
  longitude    Float
  velocidade   Float?   // km/h
  direcao      Float?   // graus (0-360)
  timestamp    DateTime @default(now())

  maquinario   Maquinario @relation(fields: [maquinarioId], references: [id])

  @@index([maquinarioId, timestamp]) // índice para consultas de histórico
}
