// ============================================================================
// SCHEMA DO BANCO DE DADOS - AGROSMART
// ============================================================================
// Este arquivo define todos os modelos (tabelas) do banco PostgreSQL.
// Após editar, rode: npx prisma migrate dev --name <nome_da_migration>
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// USUÁRIO
// ----------------------------------------------------------------------------
model User {
  id                 Int                @id @default(autoincrement())
  name               String
  email              String             @unique
  password           String
  role               String             @default("user")
  avatar             String?
  phone              String?
  timezone           String?            @default("America/Sao_Paulo")
  language           String?            @default("pt-BR")

  plan               String             @default("free")
  planExpiresAt      DateTime?
  mpSubscriptionId   String?

  resetToken         String?
  resetTokenExpires  DateTime?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  fazendas           Fazenda[]
  pushSubscriptions  PushSubscription[]
}

// ----------------------------------------------------------------------------
// FAZENDA
// ----------------------------------------------------------------------------
model Fazenda {
  id             Int             @id @default(autoincrement())
  nome           String
  localizacao    String
  area           Float
  cultura        String
  status         String          @default("ativa")

  userId         Int
  user           User            @relation(fields: [userId], references: [id])

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  sensores       Sensor[]
  alertas        Alerta[]
  irrigacoes     Irrigacao[]
  documentos     Documento[]
  transacoes     Transacao[]
  financiamentos Financiamento[]
  colaboradores  Colaborador[]
  tarefas        Tarefa[]
  insumos        Insumo[]            // NOVO: itens de estoque
  movimentacoes  MovimentacaoEstoque[] // NOVO: histórico de entrada/saída
}

// ----------------------------------------------------------------------------
// SENSOR
// ----------------------------------------------------------------------------
model Sensor {
  id            Int       @id @default(autoincrement())
  codigo        String    @unique
  tipo          String
  status        String    @default("online")
  bateria       Int       @default(100)
  token         String?   @unique
  ultimaLeitura DateTime?

  fazendaId     Int
  fazenda       Fazenda   @relation(fields: [fazendaId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  leituras      Leitura[]
}

// ----------------------------------------------------------------------------
// LEITURA
// ----------------------------------------------------------------------------
model Leitura {
  id        Int      @id @default(autoincrement())
  sensorId  Int
  sensor    Sensor   @relation(fields: [sensorId], references: [id])
  valor     Float
  unidade   String
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// ALERTA
// ----------------------------------------------------------------------------
model Alerta {
  id        Int      @id @default(autoincrement())
  tipo      String
  titulo    String
  descricao String
  lido      Boolean  @default(false)

  fazendaId Int
  fazenda   Fazenda  @relation(fields: [fazendaId], references: [id])

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// IRRIGACAO
// ----------------------------------------------------------------------------
model Irrigacao {
  id        Int       @id @default(autoincrement())
  zona      String
  ativa     Boolean   @default(false)
  fluxo     Float     @default(0)
  duracao   Int       @default(30)
  proxima   DateTime?

  fazendaId Int
  fazenda   Fazenda   @relation(fields: [fazendaId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ----------------------------------------------------------------------------
// PUSH SUBSCRIPTION
// ----------------------------------------------------------------------------
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  keys      String
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// DOCUMENTO
// ----------------------------------------------------------------------------
model Documento {
  id             Int       @id @default(autoincrement())
  nome           String
  tipo           String
  arquivoUrl     String
  arquivoTipo    String
  numero         String?
  dataEmissao    DateTime?
  dataVencimento DateTime?

  fazendaId      Int
  fazenda        Fazenda   @relation(fields: [fazendaId], references: [id])

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ----------------------------------------------------------------------------
// TRANSACAO (financeiro)
// ----------------------------------------------------------------------------
model Transacao {
  id          Int      @id @default(autoincrement())
  tipo        String
  categoria   String
  descricao   String
  valor       Float
  data        DateTime

  fazendaId   Int
  fazenda     Fazenda  @relation(fields: [fazendaId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// FINANCIAMENTO (CPR / financiamentos)
// ----------------------------------------------------------------------------
model Financiamento {
  id              Int       @id @default(autoincrement())
  tipo            String
  instituicao     String
  descricao       String?
  valor           Float
  taxaJuros       Float?
  dataContratacao DateTime?
  dataVencimento  DateTime?
  status          String    @default("ativo")

  fazendaId       Int
  fazenda         Fazenda   @relation(fields: [fazendaId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ----------------------------------------------------------------------------
// COLABORADOR
// ----------------------------------------------------------------------------
model Colaborador {
  id           Int             @id @default(autoincrement())
  nome         String
  funcao       String
  telefone     String?
  email        String?
  dataAdmissao DateTime?
  salario      Float?
  status       String          @default("ativo")

  fazendaId    Int
  fazenda      Fazenda         @relation(fields: [fazendaId], references: [id])

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tarefas        Tarefa[]
  registrosPonto RegistroPonto[]
}

// ----------------------------------------------------------------------------
// TAREFA
// ----------------------------------------------------------------------------
model Tarefa {
  id            Int          @id @default(autoincrement())
  titulo        String
  descricao     String?
  status        String       @default("pendente")
  prioridade    String       @default("media")
  dataPrazo     DateTime?

  colaboradorId Int?
  colaborador   Colaborador? @relation(fields: [colaboradorId], references: [id])

  fazendaId     Int
  fazenda       Fazenda      @relation(fields: [fazendaId], references: [id])

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// ----------------------------------------------------------------------------
// REGISTRO DE PONTO
// ----------------------------------------------------------------------------
model RegistroPonto {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])

  data          DateTime
  entrada       DateTime?
  saida         DateTime?
  observacao    String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ============================================================================
// NOVO: ESTOQUE DE INSUMOS
// ============================================================================

// ----------------------------------------------------------------------------
// INSUMO - Item de estoque (semente, fertilizante, defensivo, etc.)
// ----------------------------------------------------------------------------
// O campo "quantidade" é a quantidade ATUAL em estoque. Toda alteração nesse
// valor deve ser feita através de uma MovimentacaoEstoque (entrada/saída),
// nunca editada diretamente - isso garante histórico e auditoria.
// ----------------------------------------------------------------------------
model Insumo {
  id             Int      @id @default(autoincrement())
  nome           String
  categoria      String   // Semente | Fertilizante | Defensivo | Combustível | Outro
  unidade        String   // kg, L, sc (saco), ton, un
  quantidade     Float    @default(0) // quantidade atual em estoque
  estoqueMinimo  Float    @default(0) // dispara alerta quando quantidade <= isso
  precoUnitario  Float?   // custo médio por unidade (opcional, para relatórios)
  fornecedor     String?

  fazendaId      Int
  fazenda        Fazenda  @relation(fields: [fazendaId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  movimentacoes  MovimentacaoEstoque[]
}

// ----------------------------------------------------------------------------
// MOVIMENTACAO ESTOQUE - Histórico de entrada/saída de um insumo
// ----------------------------------------------------------------------------
model MovimentacaoEstoque {
  id          Int      @id @default(autoincrement())
  tipo        String   // "entrada" | "saida"
  quantidade  Float    // sempre positiva - o "tipo" define a direção
  motivo      String?  // ex: "Compra", "Aplicação no setor B", "Perda/avaria"
  data        DateTime @default(now())

  insumoId    Int
  insumo      Insumo   @relation(fields: [insumoId], references: [id])

  // Denormalizado para facilitar consultas e relatórios sem precisar
  // sempre fazer join com Insumo -> Fazenda
  fazendaId   Int
  fazenda     Fazenda  @relation(fields: [fazendaId], references: [id])

  createdAt   DateTime @default(now())
}
