// ============================================================================
// SCHEMA DO BANCO DE DADOS - AGROSMART
// ============================================================================
// Após editar, rode: npx prisma migrate dev --name <nome_da_migration>
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// USUÁRIO
// ----------------------------------------------------------------------------
model User {
  id                 Int                @id @default(autoincrement())
  name               String
  email              String             @unique
  password           String
  role               String             @default("user")
  avatar             String?
  phone              String?
  timezone           String?            @default("America/Sao_Paulo")
  language           String?            @default("pt-BR")
  plan               String             @default("free")
  planExpiresAt      DateTime?
  mpSubscriptionId   String?
  resetToken         String?
  resetTokenExpires  DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  fazendas           Fazenda[]
  pushSubscriptions  PushSubscription[]
}

// ----------------------------------------------------------------------------
// FAZENDA
// ----------------------------------------------------------------------------
model Fazenda {
  id             Int                   @id @default(autoincrement())
  nome           String
  localizacao    String
  area           Float
  cultura        String
  status         String                @default("ativa")
  userId         Int
  user           User                  @relation(fields: [userId], references: [id])
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  sensores       Sensor[]
  alertas        Alerta[]
  irrigacoes     Irrigacao[]
  documentos     Documento[]
  transacoes     Transacao[]
  financiamentos Financiamento[]
  colaboradores  Colaborador[]
  tarefas        Tarefa[]
  insumos        Insumo[]
  movimentacoes  MovimentacaoEstoque[]
  lotes          Lote[]                // NOVO: lotes do rebanho
  gtas           Gta[]                 // NOVO: GTAs emitidas
}

// ----------------------------------------------------------------------------
// Os demais modelos existentes (Sensor, Leitura, Alerta, Irrigacao,
// PushSubscription, Documento, Transacao, Financiamento, Colaborador,
// Tarefa, RegistroPonto, Insumo, MovimentacaoEstoque) são mantidos
// idênticos às versões anteriores — omitidos aqui por brevidade mas
// presentes no arquivo real enviado ao usuário.
// ----------------------------------------------------------------------------

model Sensor {
  id            Int       @id @default(autoincrement())
  codigo        String    @unique
  tipo          String
  status        String    @default("online")
  bateria       Int       @default(100)
  token         String?   @unique
  ultimaLeitura DateTime?
  fazendaId     Int
  fazenda       Fazenda   @relation(fields: [fazendaId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  leituras      Leitura[]
}

model Leitura {
  id        Int      @id @default(autoincrement())
  sensorId  Int
  sensor    Sensor   @relation(fields: [sensorId], references: [id])
  valor     Float
  unidade   String
  createdAt DateTime @default(now())
}

model Alerta {
  id        Int      @id @default(autoincrement())
  tipo      String
  titulo    String
  descricao String
  lido      Boolean  @default(false)
  fazendaId Int
  fazenda   Fazenda  @relation(fields: [fazendaId], references: [id])
  createdAt DateTime @default(now())
}

model Irrigacao {
  id        Int       @id @default(autoincrement())
  zona      String
  ativa     Boolean   @default(false)
  fluxo     Float     @default(0)
  duracao   Int       @default(30)
  proxima   DateTime?
  fazendaId Int
  fazenda   Fazenda   @relation(fields: [fazendaId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  keys      String
  createdAt DateTime @default(now())
}

model Documento {
  id             Int       @id @default(autoincrement())
  nome           String
  tipo           String
  arquivoUrl     String
  arquivoTipo    String
  numero         String?
  dataEmissao    DateTime?
  dataVencimento DateTime?
  fazendaId      Int
  fazenda        Fazenda   @relation(fields: [fazendaId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Transacao {
  id          Int      @id @default(autoincrement())
  tipo        String
  categoria   String
  descricao   String
  valor       Float
  data        DateTime
  fazendaId   Int
  fazenda     Fazenda  @relation(fields: [fazendaId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Financiamento {
  id              Int       @id @default(autoincrement())
  tipo            String
  instituicao     String
  descricao       String?
  valor           Float
  taxaJuros       Float?
  dataContratacao DateTime?
  dataVencimento  DateTime?
  status          String    @default("ativo")
  fazendaId       Int
  fazenda         Fazenda   @relation(fields: [fazendaId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Colaborador {
  id             Int             @id @default(autoincrement())
  nome           String
  funcao         String
  telefone       String?
  email          String?
  dataAdmissao   DateTime?
  salario        Float?
  status         String          @default("ativo")
  fazendaId      Int
  fazenda        Fazenda         @relation(fields: [fazendaId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tarefas        Tarefa[]
  registrosPonto RegistroPonto[]
}

model Tarefa {
  id            Int          @id @default(autoincrement())
  titulo        String
  descricao     String?
  status        String       @default("pendente")
  prioridade    String       @default("media")
  dataPrazo     DateTime?
  colaboradorId Int?
  colaborador   Colaborador? @relation(fields: [colaboradorId], references: [id])
  fazendaId     Int
  fazenda       Fazenda      @relation(fields: [fazendaId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model RegistroPonto {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  data          DateTime
  entrada       DateTime?
  saida         DateTime?
  observacao    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Insumo {
  id            Int                   @id @default(autoincrement())
  nome          String
  categoria     String
  unidade       String
  quantidade    Float                 @default(0)
  estoqueMinimo Float                 @default(0)
  precoUnitario Float?
  fornecedor    String?
  fazendaId     Int
  fazenda       Fazenda               @relation(fields: [fazendaId], references: [id])
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  movimentacoes MovimentacaoEstoque[]
}

model MovimentacaoEstoque {
  id         Int      @id @default(autoincrement())
  tipo       String
  quantidade Float
  motivo     String?
  data       DateTime @default(now())
  insumoId   Int
  insumo     Insumo   @relation(fields: [insumoId], references: [id])
  fazendaId  Int
  fazenda    Fazenda  @relation(fields: [fazendaId], references: [id])
  createdAt  DateTime @default(now())
}

// ============================================================================
// NOVO: PECUÁRIA
// ============================================================================

// ----------------------------------------------------------------------------
// LOTE - Grupo de animais de uma mesma espécie/categoria em uma fazenda
// ----------------------------------------------------------------------------
// Um "lote" representa um agrupamento gerenciável: ex. "Bezerros machos 2026",
// "Vacas em lactação", "Matrizes suínas" etc.
// Os animais individuais são rastreados dentro do lote via Animal.
// ----------------------------------------------------------------------------
model Lote {
  id        Int       @id @default(autoincrement())
  nome      String                    // ex: "Bezerros machos 2026"
  especie   String                    // Bovino | Suíno | Aves | Equino | Outro
  categoria String                    // ex: Bezerro, Novilha, Vaca, Touro, etc.
  localizacao String?                 // pasto/curral onde está o lote
  observacao  String?

  fazendaId Int
  fazenda   Fazenda   @relation(fields: [fazendaId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  animais   Animal[]
  vacinacoes VacinacaoLote[]
