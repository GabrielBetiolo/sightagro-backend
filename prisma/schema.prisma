// ============================================================================
// SCHEMA DO BANCO DE DADOS - AGROSMART
// ============================================================================
// Este arquivo define todos os modelos (tabelas) do banco PostgreSQL.
// Após editar, rode: npx prisma migrate dev --name <nome_da_migration>
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// USUÁRIO
// ----------------------------------------------------------------------------
model User {
  id                 Int                @id @default(autoincrement())
  name               String
  email              String             @unique
  password           String
  role               String             @default("user")
  avatar             String?
  phone              String?
  timezone           String?            @default("America/Sao_Paulo")
  language           String?            @default("pt-BR")

  plan               String             @default("free")
  planExpiresAt      DateTime?
  mpSubscriptionId   String?

  resetToken         String?
  resetTokenExpires  DateTime?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  fazendas           Fazenda[]
  pushSubscriptions  PushSubscription[]
}

// ----------------------------------------------------------------------------
// FAZENDA
// ----------------------------------------------------------------------------
model Fazenda {
  id          Int          @id @default(autoincrement())
  nome        String
  localizacao String
  area        Float
  cultura     String
  status      String       @default("ativa")

  userId      Int
  user        User         @relation(fields: [userId], references: [id])

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sensores    Sensor[]
  alertas     Alerta[]
  irrigacoes  Irrigacao[]
  documentos  Documento[]
  transacoes  Transacao[]    // NOVO: lançamentos financeiros
  financiamentos Financiamento[] // NOVO: CPR / financiamentos
}

// ----------------------------------------------------------------------------
// SENSOR
// ----------------------------------------------------------------------------
model Sensor {
  id            Int       @id @default(autoincrement())
  codigo        String    @unique
  tipo          String
  status        String    @default("online")
  bateria       Int       @default(100)
  token         String?   @unique
  ultimaLeitura DateTime?

  fazendaId     Int
  fazenda       Fazenda   @relation(fields: [fazendaId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  leituras      Leitura[]
}

// ----------------------------------------------------------------------------
// LEITURA
// ----------------------------------------------------------------------------
model Leitura {
  id        Int      @id @default(autoincrement())
  sensorId  Int
  sensor    Sensor   @relation(fields: [sensorId], references: [id])
  valor     Float
  unidade   String
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// ALERTA
// ----------------------------------------------------------------------------
model Alerta {
  id        Int      @id @default(autoincrement())
  tipo      String
  titulo    String
  descricao String
  lido      Boolean  @default(false)

  fazendaId Int
  fazenda   Fazenda  @relation(fields: [fazendaId], references: [id])

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// IRRIGACAO
// ----------------------------------------------------------------------------
model Irrigacao {
  id        Int       @id @default(autoincrement())
  zona      String
  ativa     Boolean   @default(false)
  fluxo     Float     @default(0)
  duracao   Int       @default(30)
  proxima   DateTime?

  fazendaId Int
  fazenda   Fazenda   @relation(fields: [fazendaId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ----------------------------------------------------------------------------
// PUSH SUBSCRIPTION
// ----------------------------------------------------------------------------
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  keys      String
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// DOCUMENTO - documentos da propriedade (INCRA, ITR, CCIR, GTA, etc.)
// ----------------------------------------------------------------------------
model Documento {
  id             Int       @id @default(autoincrement())
  nome           String
  tipo           String
  arquivoUrl     String
  arquivoTipo    String
  numero         String?
  dataEmissao    DateTime?
  dataVencimento DateTime?

  fazendaId      Int
  fazenda        Fazenda   @relation(fields: [fazendaId], references: [id])

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ============================================================================
// NOVO: GESTÃO FINANCEIRA RURAL
// ============================================================================

// ----------------------------------------------------------------------------
// TRANSACAO - Lançamento financeiro (receita ou despesa)
// ----------------------------------------------------------------------------
// Representa qualquer movimento de caixa relacionado à fazenda: venda de
// produção (receita), compra de insumos, mão de obra, maquinário (despesas).
// ----------------------------------------------------------------------------
model Transacao {
  id          Int      @id @default(autoincrement())
  tipo        String   // "receita" | "despesa"
  categoria   String   // ex: Insumos, Maquinário, Mão de obra, Venda, Outros
  descricao   String
  valor       Float    // sempre positivo - o "tipo" define o sinal
  data        DateTime // data em que o lançamento ocorreu (não createdAt)

  fazendaId   Int
  fazenda     Fazenda  @relation(fields: [fazendaId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// FINANCIAMENTO - CPR (Cédula de Produto Rural) e financiamentos bancários
// ----------------------------------------------------------------------------
// Permite acompanhar dívidas/contratos vinculados à fazenda, com vencimento
// e geração automática de alertas (mesmo padrão usado em Documento).
// ----------------------------------------------------------------------------
model Financiamento {
  id              Int       @id @default(autoincrement())
  tipo            String    // "CPR" | "Financiamento" | "Outro"
  instituicao     String    // banco / cooperativa / comprador (no caso de CPR)
  descricao       String?   // observações livres
  valor           Float     // valor total contratado
  taxaJuros       Float?    // taxa de juros anual (%), opcional
  dataContratacao DateTime?
  dataVencimento  DateTime? // usado para gerar alertas de vencimento
  status          String    @default("ativo") // "ativo" | "pago" | "vencido"

  fazendaId       Int
  fazenda         Fazenda   @relation(fields: [fazendaId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
