// schema.prisma — SightAgro
// Acumula TODOS os modelos do projeto (substitui o arquivo existente)
// Migration: npx prisma migrate dev --name add_praga

generator client {
  provider      = "prisma-client-js"
  // binaryTargets necessário para o Render (Linux)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Usuário ──────────────────────────────────────────────────────────────────
model User {
  id            Int       @id @default(autoincrement())
  nome          String
  email         String    @unique
  senha         String
  avatarUrl     String?
  telefone      String?
  idioma        String?   @default("pt")
  fusoHorario   String?   @default("America/Sao_Paulo")
  tema          String?   @default("dark")
  plano         String    @default("free")    // free | pro | enterprise
  assinaturaId  String?                        // ID da assinatura no Mercado Pago
  resetToken    String?
  resetTokenExp DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  fazendas      Fazenda[]
  colaboradores Colaborador[]
}

// ─── Fazenda ──────────────────────────────────────────────────────────────────
model Fazenda {
  id         Int      @id @default(autoincrement())
  userId     Int
  nome       String
  localizacao String?
  latitude   Float?
  longitude  Float?
  areaHa     Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  sensores   Sensor[]
  alertas    Alerta[]
  irrigacoes Irrigacao[]
  documentos Documento[]
  transacoes TransacaoFinanceira[]
  insumosMovimentacoes MovimentacaoEstoque[]
  lotes      Lote[]           // Pecuária
  tanques    Tanque[]         // Aquicultura
  pragas     Praga[]          // Manejo de Pragas ← NOVO
}

// ─── Sensor ───────────────────────────────────────────────────────────────────
model Sensor {
  id        Int      @id @default(autoincrement())
  fazendaId Int
  nome      String
  codigo    String   @unique
  tipo      String   // temperatura | umidade | solo | ph | outros
  ativo     Boolean  @default(true)
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())

  fazenda   Fazenda   @relation(fields: [fazendaId], references: [id])
  leituras  Leitura[]
}

// ─── Leitura de Sensor ────────────────────────────────────────────────────────
model Leitura {
  id        Int      @id @default(autoincrement())
  sensorId  Int
  valor     Float
  unidade   String
  timestamp DateTime @default(now())

  sensor    Sensor @relation(fields: [sensorId], references: [id])
}

// ─── Alerta ───────────────────────────────────────────────────────────────────
model Alerta {
  id        Int      @id @default(autoincrement())
  fazendaId Int
  tipo      String   // sensor | clima | irrigacao | praga | documento | financeiro | estoque
  titulo    String
  mensagem  String
  nivel     String   // info | medio | alto | critico
  lido      Boolean  @default(false)
  createdAt DateTime @default(now())

  fazenda   Fazenda @relation(fields: [fazendaId], references: [id])
}

// ─── Irrigação ────────────────────────────────────────────────────────────────
model Irrigacao {
  id          Int      @id @default(autoincrement())
  fazendaId   Int
  nome        String
  tipo        String   // gotejamento | aspersao | pivô | manual
  status      String   @default("inativo") // ativo | inativo | programado
  agendamento String?  // cron ou horário
  duracaoMin  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fazenda     Fazenda @relation(fields: [fazendaId], references: [id])
}

// ─── Notificação Push ─────────────────────────────────────────────────────────
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ─── Documento Rural ─────────────────────────────────────────────────────────
model Documento {
  id          Int       @id @default(autoincrement())
  fazendaId   Int
  nome        String
  tipo        String    // incra | itr | ccir | matricula | gta | licenca | outro
  numero      String?
  dataEmissao DateTime?
  dataVencimento DateTime?
  urlArquivo  String?   // Cloudinary URL
  observacoes String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  fazenda     Fazenda   @relation(fields: [fazendaId], references: [id])
}

// ─── Financeiro ───────────────────────────────────────────────────────────────
model TransacaoFinanceira {
  id          Int      @id @default(autoincrement())
  fazendaId   Int
  tipo        String   // receita | despesa
  categoria   String   // semente | fertilizante | defensivo | maquinario | mao_obra | venda | outro
  descricao   String
  valor       Float
  data        DateTime
  comprovante String?  // URL Cloudinary
  createdAt   DateTime @default(now())

  fazenda     Fazenda  @relation(fields: [fazendaId], references: [id])
}

// ─── Colaborador ──────────────────────────────────────────────────────────────
model Colaborador {
  id        Int      @id @default(autoincrement())
  userId    Int      // dono da conta
  nome      String
  funcao    String   // operador | tratorista | agrônomo | gerente | outro
  telefone  String?
  email     String?
  salario   Float?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  tarefas   Tarefa[]
  registrosPonto RegistroPonto[]
}

model Tarefa {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  titulo        String
  descricao     String?
  status        String      @default("pendente") // pendente | em_andamento | concluida
  prioridade    String      @default("normal")   // baixa | normal | alta
  dataLimite    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
}

model RegistroPonto {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  data          DateTime    @default(now())
  entrada       DateTime
  saida         DateTime?
